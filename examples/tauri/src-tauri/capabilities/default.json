{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the main window run the afm-bridge sidecar and nothing else from the shell plugin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/afm-bridge-server", "sidecar": true, "args": false }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
